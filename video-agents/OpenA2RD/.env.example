# Google Gemini API (required - used for MLLM reasoning)
GEMINI_API_KEY=your_gemini_api_key_here

# Image Generation (TI2I) - Nano Banana 2 or compatible
# Options: "nano_banana" (default, via Google API), "local_sdxl" (local Stable Diffusion)
TI2I_BACKEND=nano_banana

# Video Generation (TI2V) - Veo 3.1 or compatible
# Options: "veo" (default, via Google API), "local_ltx" (LTX-Video), "local_wan" (Wan 2.2)
TI2V_BACKEND=veo

# Google Cloud (required for Veo/Nano Banana)
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_CLOUD_LOCATION=us-central1

# Optional: OpenAI-compatible API for alternative MLLM
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Output settings
OUTPUT_DIR=./outputs
LOG_LEVEL=INFO

# Performance settings
MAX_REFINEMENT_ITERATIONS_FRAME=2
MAX_REFINEMENT_ITERATIONS_VIDEO=2
MAX_CANDIDATES_PER_FRAME=3
MAX_CANDIDATES_PER_VIDEO=3
EARLY_STOP_THRESHOLD=9.0
